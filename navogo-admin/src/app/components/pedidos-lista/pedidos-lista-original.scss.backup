// ========================================================================
// PEDIDOS DASHBOARD - REDISEÑO COMPLETO
// ========================================================================

.pedidos-dashboard {
  min-height: 100vh;
  background: #f9fafb;
}

// ========================================================================
// HEADER FIJO
// ========================================================================

.pedidos-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #0F4D2A;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  gap: 20px;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.header-title {
  font-family: 'Sora', sans-serif;
  font-weight: 700;
  font-size: 20px;
  color: white;
  margin: 0;
  letter-spacing: 0.3px;
}

.header-badge {
  background: #1C8C40;
  color: white;
  font-weight: 700;
  font-size: 13px;
  padding: 4px 10px;
  border-radius: 20px;
  min-width: 28px;
  text-align: center;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.header-control {
  ::ng-deep .mat-mdc-text-field-wrapper {
    background: transparent;
  }

  ::ng-deep .mat-mdc-form-field-infix {
    padding-top: 8px;
    padding-bottom: 8px;
    min-height: 36px;
  }

  ::ng-deep .mdc-text-field--outlined .mdc-notched-outline {
    .mdc-notched-outline__leading,
    .mdc-notched-outline__notch,
    .mdc-notched-outline__trailing {
      border-color: rgba(255, 255, 255, 0.3) !important;
    }
  }

  ::ng-deep .mat-mdc-form-field-focus-overlay {
    background: transparent;
  }

  ::ng-deep input,
  ::ng-deep .mat-mdc-select-value {
    color: white !important;
  }

  ::ng-deep .mat-mdc-select-arrow,
  ::ng-deep .mat-datepicker-toggle button {
    color: white !important;
  }

  ::ng-deep .mat-mdc-form-field-subscript-wrapper {
    display: none;
  }

  max-width: 180px;
  margin-bottom: 0 !important;
}

.header-btn {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: white;
  height: 36px;
  padding: 0 16px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  white-space: nowrap;

  &:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
  }

  &--active {
    background: #1C8C40;
    border-color: #1C8C40;
  }
}

@media (max-width: 1200px) {
  .header-right {
    flex-wrap: wrap;
  }
}

@media (max-width: 767px) {
  .pedidos-header {
    height: auto;
    flex-direction: column;
    align-items: flex-start;
    padding: 12px;
    gap: 12px;
  }

  .header-right {
    width: 100%;
    overflow-x: auto;
    flex-wrap: nowrap;
    
    &::-webkit-scrollbar {
      display: none;
    }
  }

  .header-control {
    min-width: 160px;
  }
}

// ========================================================================
// BARRA DE FILTROS
// ========================================================================

.pedidos-filters {
  background: white;
  border-bottom: 0.5px solid #e5e7eb;
  padding: 12px 20px;
  min-height: 50px;
}

// ========================================================================
// ESTADOS DE CARGA Y VACÍO
// ========================================================================

.pedidos-loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80px 20px;
}

.pedidos-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 20px;
  text-align: center;
}

.empty-icon {
  font-size: 64px;
  width: 64px;
  height: 64px;
  color: #d1d5db;
  margin-bottom: 16px;
}

.empty-title {
  font-size: 16px;
  color: #6b7280;
  margin: 0 0 8px 0;
  font-weight: 600;
}

.empty-subtitle {
  font-size: 14px;
  color: #9ca3af;
  margin: 0;
}

// ========================================================================
// GRID DE PEDIDOS
// ========================================================================

.pedidos-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  padding: 20px;
}

@media (max-width: 1200px) {
  .pedidos-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 767px) {
  .pedidos-grid {
    grid-template-columns: 1fr;
    padding: 12px;
    gap: 12px;
  }
}

// ========================================================================
// TARJETA DE PEDIDO
// ========================================================================

.pedido-card {
  background: white;
  border: 0.5px solid #e5e7eb;
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: box-shadow 0.2s ease;
  border-left: 4px solid transparent;
  cursor: pointer;

  &:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }
}

.pedido-card--local {
  border-left-color: #1C8C40;
}

.pedido-card--llevar {
  border-left-color: #854F0B;
}

.pedido-card--domicilio {
  border-left-color: #185FA5;
}

.pedido-card--finalizado {
  opacity: 0.75;
  border-left-color: #9ca3af;

  &:hover {
    opacity: 1;
  }
}

.pedido-card--cancelado {
  opacity: 0.6;
  border-left-color: #A32D2D;

  &:hover {
    opacity: 0.8;
  }
}

// ========================================================================
// ZONA SUPERIOR: Header de la tarjeta
// ========================================================================

.card-header {
  background: rgba(0, 0, 0, 0.01);
  padding: 12px 14px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  border-bottom: 0.5px solid #e5e7eb;
}

.pedido-card--local .card-header {
  background: rgba(28, 140, 64, 0.04);
}

.pedido-card--llevar .card-header {
  background: rgba(133, 79, 11, 0.04);
}

.pedido-card--domicilio .card-header {
  background: rgba(24, 95, 165, 0.04);
}

.header-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.folio {
  font-family: 'Sora', sans-serif;
  font-weight: 800;
  font-size: 22px;
  color: #1A1A11;
  letter-spacing: 0.2px;
}

.hora {
  font-size: 12px;
  color: #6b7280;
  font-weight: 500;
}

.sucursal-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: rgba(28,140,64,0.08);
  border: 1px solid rgba(28,140,64,0.2);
  border-radius: 6px;
  padding: 3px 8px;
  max-width: fit-content;
  margin-top: 4px;

  &__icono {
    font-size: 13px;
    width: 13px;
    height: 13px;
    color: #1C8C40;
    flex-shrink: 0;
  }

  &__nombre {
    font-size: 12px;
    font-weight: 600;
    color: #1C8C40;
    white-space: nowrap;
  }
}

.sin-sucursal {
  color: var(--mat-sys-on-surface-variant);
  font-size: 14px;
}

.tiempo-ok {
  font-size: 11px;
  color: #9ca3af;
  margin-top: 2px;
}

.urgencia {
  font-size: 11px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 20px;
  margin-top: 4px;
  display: inline-block;

  &.advertencia {
    background: #FAEEDA;
    color: #854F0B;
  }

  &.urgente {
    background: #FCEBEB;
    color: #A32D2D;
    animation: pulse-urgente 2s infinite;
  }
}

@keyframes pulse-urgente {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.6;
  }
}

.header-chips {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.status-chip {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  padding: 4px 10px;
  border-radius: 20px;
  background: #f3f4f6;
  color: #9ca3af;
  transition: all 0.2s;

  mat-icon {
    width: 14px;
    height: 14px;
    font-size: 14px;
  }

  &--activo {
    background: #EAF3DE;
    color: #3B6D11;

    mat-icon {
      color: #3B6D11;
    }
  }

  &--pago.status-chip--activo {
    background: #E6F1FB;
    color: #185FA5;

    mat-icon {
      color: #185FA5;
    }
  }

  &--servido.status-chip--activo {
    background: #FAEEDA;
    color: #854F0B;

    mat-icon {
      color: #854F0B;
    }
  }
}

// ========================================================================
// ZONA MEDIA: Info del cliente y total
// ========================================================================

.card-info {
  padding: 12px 14px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  border-bottom: 0.5px solid #e5e7eb;
}

.cliente-info {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
  min-width: 0;
}

.tipo-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 20px;
  width: fit-content;

  mat-icon {
    width: 14px;
    height: 14px;
    font-size: 14px;
  }

  &--local {
    background: rgba(28, 140, 64, 0.12);
    color: #1C8C40;

    mat-icon {
      color: #1C8C40;
    }
  }

  &--llevar {
    background: rgba(133, 79, 11, 0.12);
    color: #854F0B;

    mat-icon {
      color: #854F0B;
    }
  }

  &--domicilio {
    background: rgba(24, 95, 165, 0.12);
    color: #185FA5;

    mat-icon {
      color: #185FA5;
    }
  }
}

.nombre-cliente {
  font-size: 15px;
  font-weight: 600;
  color: #1A1A11;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metodo-pago {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: #6b7280;

  mat-icon {
    width: 14px;
    height: 14px;
    font-size: 14px;
    color: #9ca3af;
  }
}

.total-info {
  text-align: right;
  min-width: fit-content;
}

.total-label {
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  color: #6b7280;
  letter-spacing: 0.08em;
}

.total-monto {
  font-family: 'Sora', sans-serif;
  font-weight: 700;
  font-size: 24px;
  color: #1A1A11;
  margin-top: 2px;
}

// ========================================================================
// ZONA ITEMS: Comanda
// ========================================================================

.card-comanda {
  padding: 0 14px;
  border-bottom: 0.5px solid #e5e7eb;
}

.comanda-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  color: #6b7280;
  letter-spacing: 0.08em;
}

.badge-cantidad {
  background: #f3f4f6;
  color: #6b7280;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 10px;
}

.comanda-items {
  display: flex;
  flex-direction: column;
}

.comanda-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 5px 0;
  border-bottom: 0.5px solid rgba(229, 231, 235, 0.5);
  gap: 8px;

  &:last-child {
    border-bottom: none;
  }
}

.item-left {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
}

.item-cantidad {
  background: #f3f4f6;
  color: #1A1A11;
  font-weight: 700;
  font-size: 12px;
  padding: 4px 8px;
  border-radius: 50%;
  min-width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.item-detalles {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
  flex: 1;
}

.item-nombre {
  font-size: 13px;
  color: #1A1A11;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-extras {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.extra-chip {
  font-size: 10px;
  padding: 1px 6px;
  background: rgba(28, 140, 64, 0.08);
  color: #1C8C40;
  border-radius: 20px;
  font-weight: 500;
}

.item-precio {
  font-size: 13px;
  font-weight: 600;
  color: #1A1A11;
  white-space: nowrap;
  flex-shrink: 0;
}

.ver-mas {
  font-size: 12px;
  color: #1C8C40;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 8px 0;
  text-align: left;
  font-weight: 500;
  text-decoration: none;

  &:hover {
    text-decoration: underline;
  }
}

// ========================================================================
// ZONA NOTAS
// ========================================================================

.card-nota {
  background: rgba(133, 79, 11, 0.06);
  border-top: 0.5px solid rgba(133, 79, 11, 0.15);
  padding: 8px 14px;
  display: flex;
  gap: 8px;
  align-items: flex-start;

  mat-icon {
    width: 16px;
    height: 16px;
    font-size: 16px;
    color: #854F0B;
    flex-shrink: 0;
  }
}

.nota-texto {
  font-size: 12px;
  color: #854F0B;
  font-style: italic;
  line-height: 1.5;
}

// ========================================================================
// ZONA INFERIOR: Acciones
// ========================================================================

.card-acciones {
  padding: 10px 14px;
  border-top: 0.5px solid #e5e7eb;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.btn-detalle {
  display: flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  border: 1px solid #d1d5db;
  color: #6b7280;
  height: 34px;
  padding: 0 12px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;

  mat-icon {
    width: 14px;
    height: 14px;
    font-size: 14px;
  }

  &:hover {
    background: #f9fafb;
    border-color: #9ca3af;
  }
}

.acciones-btns {
  display: flex;
  gap: 8px;
  align-items: center;
}

.btn-accion {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  cursor: pointer;
  transition: all 0.2s;

  mat-icon {
    width: 18px;
    height: 18px;
    font-size: 18px;
  }

  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  // Estado NO confirmado
  &--pago {
    background: #E6F1FB;

    mat-icon {
      color: #185FA5;
    }

    &:hover:not(:disabled) {
      background: rgba(230, 241, 251, 0.7);
    }
  }

  // Estado confirmado
  &--pago-activo {
    background: #185FA5;

    mat-icon {
      color: white;
    }

    &:hover:not(:disabled) {
      background: rgba(24, 95, 165, 0.9);
    }
  }

  &--servido {
    background: #FAEEDA;

    mat-icon {
      color: #854F0B;
    }

    &:hover:not(:disabled) {
      background: rgba(250, 238, 218, 0.7);
    }
  }

  &--servido-activo {
    background: #854F0B;

    mat-icon {
      color: white;
    }

    &:hover:not(:disabled) {
      background: rgba(133, 79, 11, 0.9);
    }
  }

  &--cancelar {
    background: #FCEBEB;

    mat-icon {
      color: #A32D2D;
    }

    &:hover:not(:disabled) {
      background: #A32D2D;

      mat-icon {
        color: white;
      }
    }
  }
}
